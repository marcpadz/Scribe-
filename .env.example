[TEMPLATE]
# Scribe / NeoScriber environment configuration
# Copy this file to .env.local and fill in real values.

# Required — Google AI Studio key (Gemini)
GEMINI_API_KEY=

# Required for Google Drive features — OAuth Client ID from Google Cloud Console
# Domains must be authorized in the OAuth consent screen.
GOOGLE_CLIENT_ID=

# Auth Worker URL (Better Auth client base). Used by the frontend AuthGate.
# Local dev points at the wrangler dev server; prod points at the deployed Worker.
# For CI/prod build set this to your deployed Worker, e.g.:
VITE_AUTH_URL=http://localhost:8787
# VITE_AUTH_URL=https://scribe-auth-worker.marcpadz.workers.dev

# Cobalt API configuration for social media URL import (YouTube, TikTok, Instagram, etc.)
# The CORS proxy (functions/proxy.ts) uses Cobalt to extract media from social platforms.
# For production, self-host your own Cobalt instance and set these:
#   - Deploy: https://github.com/imputnet/cobalt
#   - Railway one-click: https://railway.com/deploy/cobalt-tools--cobalt-tools
# Leave empty to use the default Cobalt instance (may require API key).
COBALT_API_URL=
COBALT_API_KEY=

# Admin dashboard key (Worker secret ADMIN_KEY). Set via:
#   npx wrangler secret put ADMIN_KEY --config ./worker/wrangler.toml
# Not needed in .env.local — the admin console prompts for it at /#/admin.

# Email sender (Worker secret RESEND_SENDER). Set via:
#   npx wrangler secret put RESEND_SENDER --config ./worker/wrangler.toml
# Must be a verified domain in your Resend account (e.g. "NeoScriber <noreply@yourdomain.com>").
# Without this, emails won't deliver to real addresses (onboarding@resend.dev is test-only).
